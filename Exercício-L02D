Algoritmo "L02D"
// Disciplina   : [Lógica de Programação em JavaScript]
// Professor   : Jailson
// Descrição   : Ler quatro valores referentes a quatro notas escolares de um aluno e
//imprimir uma mensagem dizendo que o aluno foi aprovado, se o valor da média
//escolar for maior ou igual a 7. Se o valor da média for menor que 7, solicitar
//a nota de exame, somar com o valor da média e obter nova média. Se a nova
//média for maior ou igual a 5, apresentar uma mensagem dizendo que o aluno foi
//aprovado em exame. Se o aluno não foi aprovado, indicar uma mensagem
//informando esta condição. Apresentar com as mensagens o valor da média do
//aluno, para qualquer condição.
// Autor(a)    : Leticia Vitoria
// Data atual  : 13/09/2026
Var
   // Seção de Declarações das variáveis
   matematica, portugues, historia, educacaofisica, total, totalsegundanota, Novanota: real

Inicio
   // Seção de Comandos, procedimento, funções, operadores, etc...
   Escreval("----APROVADO OU NÃO----")
   Escreval("")

   Escreval("NOTA FINAL EM MATEMATICA:")
   Escreval("")
   Leia(matematica)

   Escreval("NOTA FINAL EM PORTUGUÊS:")
   Escreval("")
   Leia(portugues)

   Escreval("NOTA FINAL EM HISTORIA:")
   Escreval("")
   Leia(historia)
   
   Escreval("NOTA FINAL EM EDUCAÇÃO FISICA:")
   Escreval("")
   Leia(educacaofisica)

   total <-(matematica + portugues + historia + educacaofisica) / 4

   Se (total >= 7) então

      Escreval("VOCÊ FOI APROVADO COM A MÉDIA:", total)

   Senão

      Escreval("QUAL É NOTA DA RECUPERAÇAO:")
      Escreval("")
      Leia(Novanota)

      totalsegundanota<- (total + Novanota) / 2

      se (totalsegundanota >= 5) entao

         Escreval("VOCÊ FOI APROVADO COM A MÉDIA:", totalsegundanota)

      Senao

         Escreval("VOCÊ FOI REPROVADO COM A MÉDIA:", totalsegundanota)

      Fimse
   Fimse

Fimalgoritmo
