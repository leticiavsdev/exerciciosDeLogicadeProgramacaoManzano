Algoritmo "L05H"
// Disciplina   : [Lógica de Programação em JavaScript]
// Professor   : Jailson
// Descrição   :H Elaborar um programa que apresente como resultado o valor
//de uma potência de uma base qualquer elevada a um expoente qualquer, ou seja,
//de BE , em que B é o valor da base e E o valor do expoente. Observe que
//neste exercício não pode ser utilizado o operador de exponenciação do portuguol (^).
// Autor(a)    : Leticia Vitoria
// Data atual  : 26/09/2026
Var
   // Seção de Declarações das variáveis
   base, potencia, contador, expoente: inteiro

Inicio
   // Seção de Comandos, procedimento, funções, operadores, etc...
   Escreval("Escreva a base: ")
   Leia(base)

   Escreval("Escreva o expoente: ")
   Leia(expoente)

   potencia <- 1

   para contador de 1 ate expoente passo 1 faca
      potencia <- potencia * base
   fimpara

   Escreval("A potencia é: ", potencia)

Fimalgoritmo
