Algoritmo " L02L"
// Disciplina   : [Lógica de Programação em JavaScript]
// Professor   : Jailson
// Descrição   : Elaborar um programa que efetue a leitura do nome e do sexo
//de uma pessoa, apresentando com saída uma das seguintes mensagens: "Ilmo Sr."
//, se o sexo informado como masculino, ou a mensagem "Ilma Sra.", para o sexo
//informado como feminino. Apresente também junto da mensagem de saudação o nome
//previamente informado.
// Autor(a)    : Leticia Vitoria
// Data atual  : 20/09/2026
Var
   // Seção de Declarações das variáveis
   nome : caractere
   opcao: inteiro

Inicio
   // Seção de Comandos, procedimento, funções, operadores, etc...
   escreval("Escreva seu nome: ")
   leia(nome)
   Escreval("")
   Escreval("Escolha seu sexo")
   Escreval("1- Feminino")
   Escreval ("2- Masculino")
   Leia (opcao)

   escolha opcao
   caso 1
      Escreval ("Seja bem vindo Sra. ", nome ,"!")
   caso 2
      Escreval ("Seja bem vindo Sr. ", nome, "!")
    outrocaso
    Escreval("Não temos essa opção!")

   fimescolha


Fimalgoritmo
