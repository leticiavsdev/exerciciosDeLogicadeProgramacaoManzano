Algoritmo "L01J"
// Disciplina   : [Lógica de Programação em JavaScript]
// Professor    : Jailson
// Descrição    : Elaborar um programa que efetue a apresentação do valor da
//conversão em real de um valor lido em dólar. O programa deve solicitar o 1
//valor da cotação do dólar e também a quantidade de dólares disponível com o
//usuário, para que seja apresentado o valor em moeda brasileira
// Autor(a)     : Leticia Vitoria
// Data atual   : 12/09/2026
Var
   // Seção de Declarações das variáveis
   dolar, cotacao, valor: real

Inicio
   // Seção de Comandos, procedimento, funções, operadores, etc...
   Escreval("----COTAÇÃO DE DÓLAR PARA REAL----")
   Escreval("")

   Escreval("QUANTO VOCÊ TEM DÓLAR:")
   Escreval("")
   Leia(dolar)

   Escreval("QUAL A COTAÇÃO DO DÓLAR HOJE:")
   Escreval("")
   Leia(cotacao)

   valor <- dolar * cotacao

   Escreval("O VALOR EM REAIS É: R$ ", valor)

Fimalgoritmo
