Algoritmo "L01M"
// Disciplina: [Lógica de Programação em JavaScript]
// Professor : Jailson
// Descrição :  laborar um programa que efetue a leitura de três valores
//(A,B e C) e apresente como resultado final o quadrado da soma dos três
//valores lidos.
// Autor(a): Leticia Vitoria
// Data atual: 12/09/2026
Var
   // Seção de Declarações das variáveis
   A, B, C, resultado: inteiro

Inicio
   // Seção de Comandos, procedimento, funções, operadores, etc...
   Escreval("---------- QUADRADO DA SOMA ----------")
   Escreval("")

   Escreval("DIGITE O VALOR DE A:")
   Leia(A)

   Escreval("DIGITE O VALOR DE B:")
   Leia(B)

   Escreval("DIGITE O VALOR DE C:")
   Leia(C)

   resultado <- (A + B + C) * (A + B + C)

   Escreval("O QUADRADO DA SOMA É: ", resultado)

Fimalgoritmo
