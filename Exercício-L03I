Algoritmo "L03I"
// Disciplina   : [Lógica de Programação em JavaScript]
// Professor   : Jailson
// Descrição   : Elaborar um programa que efetue a leitura de 10 valores
//numéricos e apresente no final o total do somatório e a média aritmética
//dos valores lidos.
// Autor(a)    : Leticia Vitoria
// Data atual  : 19/09/2026
Var
   // Seção de Declarações das variáveis
   numero: real
   soma, media: real
   contador: inteiro
Inicio
   // Seção de Comandos, procedimento, funções, operadores, etc...

   contador <- 1
   Escreval("Soma e Média")
   Escreval("")

   enquanto contador <= 10 faca
      Escreval("Escreva o número ", contador, ":")
      Leia(numero)
      Escreval("")

      soma <- soma + numero

      contador <- contador + 1
   fimenquanto

   media <- soma / 10

   Escreval("A soma de todos os números é: ", soma:0:2)
   Escreval("A média de todos os números é: ", media:0:2)

Fimalgoritmo
