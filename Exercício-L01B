Algoritmo "L01B"
// Disciplina   : [Lógica de Programação em JavaScript]
// Professor    : Jailson
// Descrição    : Converte temperatura de Fahrenheit para Celsius
// Autor(a)     : Leticia Vitoria
// Data atual   : 12/09/2026
Var
   // Seção de Declarações das variáveis
   fahrenheit, Celsius: real

Inicio
   // Seção de Comandos, procedimento, funções, operadores, etc...
   Escreval("----------TEMPERATURA---------")
   Escreval("")

   Escreval("CONVERTER DE FAHRENHEIT PARA CELSIUS:")
   Leia(fahrenheit)

   Celsius <- ((fahrenheit - 32) * (5/9))

   Escreval("O VALOR EM CELSIUS É: ", Celsius)
Fimalgoritmo
