Algoritmo " L04B"
// Disciplina   : [Lógica de Programação em JavaScript]
// Professor   : Jailson
// Descrição   :  b) Elaborar um programa que apresente no final o somatório
//dos valores pares existentes na faixa de 1 até 500.
// Autor(a)  : Leticia Vitoria
// Data atual  : 22/09/2026
Var
   // Seção de Declarações das variáveis
   numero, pares : inteiro

Inicio
   // Seção de Comandos, procedimento, funções, operadores, etc...
   numero <- 1
   pares <- 0
   repita
      se (numero mod 2 = 0) então
         pares <- pares + numero
      fimse
      numero <- numero + 1
   ate numero >= 501


   Escreval("Resultado somatorio pares: ", pares)


Fimalgoritmo
